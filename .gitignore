# Rahasia — jangan pernah di-commit / di-push
.env

# Dependensi pihak ketiga (pasang ulang dengan `npm install`)
node_modules/

# Backup database & arsip (hanya lokal)
backups/

# Berkas runtime server
server.lock
*.tmp.*

# Status/log pencadangan eviden ke Google Drive (lokal saja)
.drive-sync/

# Kredensial OAuth Drive API (jangan pernah di-push — isi manual di hosting)
drive-api.json

# Cache render yang dibuat ulang otomatis oleh server
uploads/_pdfcache/
uploads/_dwgcache/

# File sementara Office
templates/~$*
